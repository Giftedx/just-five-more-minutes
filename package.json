{
  "name": "just-five-more-minutes",
  "private": true,
  "version": "1.0.0",
  "description": "A comedy game about playing a 2004-flavoured mini-MMO while someone reasonable asks you to tidy your room.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hub": "tsc --noEmit && vite build --base /just-five-more-minutes/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node scripts/run-browser-checks.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size:check": "node scripts/check-dist-size.mjs",
    "verify": "npm test && npm run build && npm run size:check && npm run test:browser && npm run build:hub"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "0.184.1",
    "playwright": "1.61.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
