{
  "name": "just-five-more-minutes",
  "private": true,
  "version": "1.0.0",
  "description": "A comedy game about playing a 2004-flavoured mini-MMO while someone reasonable asks you to tidy your room.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hub": "tsc --noEmit && vite build --base /just-five-more-minutes/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/three": "0.184.1",
    "playwright": "1.60.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
